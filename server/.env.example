# ---------------------------------------------------------------
# PBL4_Web server configuration. Copy to `.env` and fill in values.
# Never commit the real `.env` file.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://pbl4:CHANGE_ME@localhost:5432/pbl4_web?schema=public

# Separate database used ONLY by automated tests (it is reset by the test runner)
TEST_DATABASE_URL=postgresql://pbl4:CHANGE_ME@localhost:5432/pbl4_web_test?schema=public

# Comma-separated list of allowed browser origins (CORS + Origin check)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime in days
SESSION_TTL_DAYS=7

# bcrypt cost factor (10-14 recommended)
BCRYPT_ROUNDS=12

# Directory for uploaded images (relative to server/)
UPLOAD_DIR=uploads
# Maximum upload size in megabytes
MAX_UPLOAD_MB=5
